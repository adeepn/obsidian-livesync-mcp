# Startup configuration errors name variables and rules without echoing supplied values.
# Storage backend: couchdb | s3. Required, no default — pick one consciously;
# the server refuses to start while this is empty.
LIVESYNC_BACKEND=

# --- couchdb backend (DATABASE required; choose Basic OR JWT auth;
# URL defaults to http://localhost:5984) ---
COUCHDB_URL=http://localhost:5984
# Optional credentials: plugin Custom Headers lines, or a JSON object.
# Double quotes expand literal \n into newlines through python-dotenv.
COUCHDB_CUSTOM_HEADERS=
COUCHDB_USER=admin
COUCHDB_PASSWORD=your_password
COUCHDB_DATABASE=obsidian
# JWT alternative: REMOVE COUCHDB_USER and COUCHDB_PASSWORD above, even if empty.
# Copy plugin Experimental Settings -> Use JWT Authentication fields.
# COUCHDB_JWT_ALGORITHM=HS256
# COUCHDB_JWT_KEY=
# Startup requires /_session userCtx.name to equal this subject; check server key/algorithm/kid and clock if auth fails.
# COUCHDB_JWT_SUBJECT=
# Optional JWT Key ID (kid); empty omits kid. Nonnegative finite expiry minutes; zero uses the plugin five-minute fallback.
# COUCHDB_JWT_KEY_ID=
# Explicit empty expiry is refused; omit or use 0. Upstream JSON string "0"
# means zero seconds and cannot be represented by this numeric env setting.
# COUCHDB_JWT_EXPIRY_MINUTES=5
# HS256/HS512: base64 HMAC bytes. ES256/ES512: PKCS8 EC PEM private key; SEC1 is rejected.
# ES256: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# ES512: use secp521r1 instead of prime256v1.
# Use a quoted multiline dotenv value (or literal \n in double quotes) for PEM.
# Server verifier and complete mapping: docs/connecting-storage.md.
# Stats report auth_mode and jwt_algorithm only; MCP client auth is separate.

# --- s3 journal backend: choose exactly ONE connection form ---
# S3_ENDPOINT_URL=https://minio.local
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=vault
# S3_REGION=auto
# S3_CUSTOM_HEADERS=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=
# Alternative: one compatible sls:// connection URI instead of the fields.
# The plugin encrypted "Copy setup URI" export is NOT this format.
# Exactly one of the two forms, never both.
# LIVESYNC_S3_URI=sls://your_access_key:your_secret_key@https://minio.local?bucket=vault&region=auto&prefix=
# Device wire encoding is automatic: compact journal leaves replace unpaired
# UTF-16 units with U+FFFD; write outcomes report transport_replacements.
# Valid astral text cuts extend one UTF-16 unit and reset the next nominal size.
# Caller lone units retain Blob ingress replacement (input_surrogates_replaced).
# No lossless-boundary or encoding switch is needed. See docs/s3-journal.md.
# Shared by both forms (defaults shown):
# S3_STATE_DIR=./data
# Positive finite seconds below 2**63; fractions such as 0.25 are accepted.
# S3_REFRESH_MIN_INTERVAL_SEC=5
# S3_STATE_SIZE_WARN_MB=0

# --- client auth: the groups are mutually exclusive, set exactly ONE ---

# Bearer auth (primary mode): static token for MCP clients.
MCP_API_KEY=your_api_key

# OAuth (for the Claude.ai connector; all three variables required together):
# OAUTH_PASSWORD=your_oauth_password
# OAUTH_CLIENT_ID=your_client_id
# OAUTH_CLIENT_SECRET=your_client_secret

# --- common server settings ---
MCP_SERVER_URL=https://your-domain.com
MCP_HOST=0.0.0.0
MCP_PORT=8484

# Note: the server refuses to start while any secret still holds a
# placeholder value from this file (e.g. your_api_key).

# Whole-note UTF-8 budget: empty = max(positive vault size bytes, 256 MiB).
# Explicit nonnegative integer wins; 0 disables the text access limit.
LIVESYNC_TEXT_SCAN_MAX_BYTES=
# Regex replacement output bytes; 0 = effective text access budget.
LIVESYNC_REGEX_MAX_OUTPUT_BYTES=0
# Positive finite seconds, applies to regex search and replacement.
LIVESYNC_REGEX_TIMEOUT_SECONDS=10

# Maximum documents with a negative text verdict (LRU, both backends)
LIVESYNC_TEXT_VERDICT_CACHE_ENTRIES=65536

# Ignore-file settings derive from vault tweaks unless independently overridden.
# Vault useIgnoreFiles uses JS truthiness (empty arrays/objects are true).
# Active filters (including vault useIgnoreFiles=true) require Node.js 22+ in the
# service PATH; missing/unusable Node fails startup. No Node is needed otherwise.
# Regex lists use literal |[]| separators, not commas. ECMAScript regex;
# spaces and LF are removed; !! negates an individual expression.
LIVESYNC_SYNC_ONLY_REGEX=
LIVESYNC_SYNC_IGNORE_REGEX=
# Empty/unset derives; true or false explicitly overrides the vault.
LIVESYNC_USE_IGNORE_FILES=
# Empty/unset derives names (missing vault key defaults to .gitignore).
# Non-empty overrides comma-separated vault-relative names in each ancestor.
LIVESYNC_IGNORE_FILES=

# Device file-size policy, both backends. Empty = vault PREFERRED/device value
# (upstream default 50 MiB). Fractions allowed; <=0 disables. Restart to reload.
# Strict finite operator number; vault values instead use JavaScript numeric
# coercion (true = 1 MiB; null/false/nonnumeric = unlimited).
# Vault array scalar conversion is iterative after JSON admission (no coercion depth limit).
LIVESYNC_SYNC_MAX_SIZE_MB=

# Operational replay protection, NOT device/protocol limits. Positive values;
# all must be below 2**63. Raise the named variable within that bound, restart.
# JSON decoder capacity is separate: normal Python recursion limit 1000,
# practical depth below ~1000 depending on call stack. A depth override does
# not lift that ceiling; capacity errors report observed/configured depth
# and LIVESYNC_JOURNAL_MAX_JSON_DEPTH. Reduce nesting; raising it alone
# cannot fix decoder capacity.
# Bytes/counts/depths are integers; refresh seconds must be finite and may be
# fractional (e.g. 0.25). All values must be >0 and <2**63. Defaults below.
# See README Size behavior and replay_limits.py for derivation/headroom.
LIVESYNC_JOURNAL_MAX_LINE_BYTES=268435456
LIVESYNC_JOURNAL_MAX_INFLATED_BYTES=8589934592
LIVESYNC_JOURNAL_MAX_RECORDS=1000000
LIVESYNC_JOURNAL_MAX_JSON_DEPTH=512
LIVESYNC_JOURNAL_MAX_OBJECT_BYTES=8589934592
LIVESYNC_JOURNAL_MAX_REFRESH_KEYS=1000000
LIVESYNC_JOURNAL_MAX_REFRESH_BYTES=68719476736
LIVESYNC_JOURNAL_MAX_REFRESH_SECONDS=3600

# CouchDB enableCompression follows the vault; no environment override.
# Compressed reads are unconditional, including with the mismatch bypass flag.
# Local tweak compatibility policy (not advertised in milestone tweak_values).
# true bypasses ordinary differences, never ID/path identity or E2EE refusals.
LIVESYNC_DISABLE_CHECKING_CONFIG_MISMATCH=false
# Auto-align fully advertised, compatible-lossy chunk tweaks by tweakModified.
LIVESYNC_AUTO_ACCEPT_COMPATIBLE_TWEAK=true

# Aggregate scan note/byte limits: nonnegative integers, 0 = unlimited.
LIVESYNC_SCAN_MAX_NOTES=0
LIVESYNC_SCAN_MAX_BYTES=0
# Nonnegative finite seconds, including waiting for one of two scan slots.
# 0 = unlimited. Partial scans return a cursor and a typed stop reason.
LIVESYNC_SCAN_MAX_SECONDS=20

# Unsafe diagnostic last-line sink, separate from config.py; keep disabled.
# Requires DEBUG logging too. Never enable to collect credentials.
# LIVESYNC_UNSAFE_DEBUG=0

# Chunk settings come from the vault, not environment overrides.
# customChunkSize/minimumChunkSize follow terminating plugin behavior.
# For plugin loop refusals and recovery see docs/vault-format.md.

# Successful lossy writes append typed notices after the original result; see docs/outcome-reporting.md.

# Ignore-name lists retain empty entries and JS trim; unresolved explicit names warn in selection_unresolved_ignore_names.

# Acceptance credentials belong only in the invoking shell, never in this file.
# See docs/connecting-storage.md for disposable real-server test configuration.

# F4 acceptance uses PKCS8 EC keys and checks all four JWT algorithms;
# configure test-only variables only in the invoking shell as documented.

# Connection click paths and examples: docs/connecting-storage.md
# Operational limits/refusal remedies: docs/peer-limitations.md
# Live acceptance helper never reads this file; remote mutation needs explicit CLI flags.

# Operational transport policy; restart after changing. Unconditional S3 PUT stays single-attempt.
# COUCHDB_CONNECT_TIMEOUT_SECONDS=5
# COUCHDB_IO_TIMEOUT_SECONDS=30
# S3_CONNECT_TIMEOUT_SECONDS=5
# S3_READ_TIMEOUT_SECONDS=30
# S3_MAX_ATTEMPTS=1
# LIVESYNC_SELECTION_TIMEOUT_SECONDS=5

# Property/tag projection only; raw note text remains available.
# LIVESYNC_FRONTMATTER_MAX_NODES=20000
# LIVESYNC_FRONTMATTER_MAX_DEPTH=200
# Expanded UTF-8 strings and keys, counted at each alias occurrence.
# LIVESYNC_FRONTMATTER_MAX_BYTES=4194304

# Reporting/startup/hosting logs carry cause classes and typed fields only.
# Full variable/default reference: docs/configuration.md

# HTTP body held in memory; 0 unlimited. Separate from OAuth form cap.
LIVESYNC_MAX_REQUEST_BYTES=1073741824

# Empty derives splitter budget; positive byte override. Also caps HTTP wire/decoded
# responses (full JSON); document batches get one budget per requested key.
# Endpoint purpose: read-only POST remains a typed refusal.
# Unreadable write acknowledgement: outcome unknown; re-read before retrying.
LIVESYNC_COUCHDB_MAX_INFLATED_BYTES=

# Both custom-header groups reject transport-owned framing/routing/hop-by-hop fields.
# Content-Length, Transfer-Encoding, Host, Connection, Keep-Alive, TE, Trailer, Upgrade, Proxy-*
