# Storage backend: couchdb | s3. Required, no default — pick one consciously;
# the server refuses to start while this is empty.
LIVESYNC_BACKEND=

# --- couchdb backend (USER/PASSWORD/DATABASE required when
# LIVESYNC_BACKEND=couchdb; URL defaults to http://localhost:5984) ---
COUCHDB_URL=http://localhost:5984
# Optional credentials: plugin Custom Headers lines, or a JSON object.
# Double quotes expand literal \n into newlines through python-dotenv.
COUCHDB_CUSTOM_HEADERS=
COUCHDB_USER=admin
COUCHDB_PASSWORD=your_password
COUCHDB_DATABASE=obsidian

# --- s3 journal backend: choose exactly ONE connection form ---
# S3_ENDPOINT_URL=https://minio.local
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=vault
# S3_REGION=auto
# S3_CUSTOM_HEADERS=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=
# Alternative: one compatible sls:// connection URI instead of the fields.
# The plugin encrypted "Copy setup URI" export is NOT this format.
# Exactly one of the two forms, never both.
# LIVESYNC_S3_URI=sls://your_access_key:your_secret_key@https://minio.local?bucket=vault&region=auto&prefix=
# Device wire encoding is automatic: compact journal leaves replace unpaired
# UTF-16 units with U+FFFD; write outcomes report transport_replacements.
# No encoding override is needed. See docs/s3-journal.md.
# Shared by both forms (defaults shown):
# S3_STATE_DIR=./data
# Positive finite seconds below 2**63; fractions such as 0.25 are accepted.
# S3_REFRESH_MIN_INTERVAL_SEC=5
# S3_STATE_SIZE_WARN_MB=0

# --- client auth: the groups are mutually exclusive, set exactly ONE ---

# Bearer auth (primary mode): static token for MCP clients.
MCP_API_KEY=your_api_key

# OAuth (for the Claude.ai connector; all three variables required together):
# OAUTH_PASSWORD=your_oauth_password
# OAUTH_CLIENT_ID=your_client_id
# OAUTH_CLIENT_SECRET=your_client_secret

# --- common server settings ---
MCP_SERVER_URL=https://your-domain.com
MCP_HOST=0.0.0.0
MCP_PORT=8484

# Note: the server refuses to start while any secret still holds a
# placeholder value from this file (e.g. your_api_key).

# Per-newnote text scan byte budget
LIVESYNC_TEXT_SCAN_MAX_BYTES=8388608

# Maximum documents with a negative text verdict (LRU, both backends)
LIVESYNC_TEXT_VERDICT_CACHE_ENTRIES=4096

# Ignore-file settings derive from vault tweaks unless independently overridden.
# Active filters (including vault useIgnoreFiles=true) require Node.js 22+ in the
# service PATH; missing/unusable Node fails startup. No Node is needed otherwise.
# Regex lists use literal |[]| separators, not commas. ECMAScript regex;
# spaces and LF are removed; !! negates an individual expression.
LIVESYNC_SYNC_ONLY_REGEX=
LIVESYNC_SYNC_IGNORE_REGEX=
# Empty/unset derives; true or false explicitly overrides the vault.
LIVESYNC_USE_IGNORE_FILES=
# Empty/unset derives names (missing vault key defaults to .gitignore).
# Non-empty overrides comma-separated vault-relative names in each ancestor.
LIVESYNC_IGNORE_FILES=

# Device file-size policy, both backends. Empty = vault PREFERRED/device value
# (upstream default 50 MiB). Fractions allowed; <=0 disables. Restart to reload.
LIVESYNC_SYNC_MAX_SIZE_MB=

# Operational replay protection, NOT device/protocol limits. Positive values;
# all must be below 2**63. Raise the named variable within that bound, restart.
# JSON decoder capacity is separate: normal Python recursion limit 1000,
# practical depth below ~1000 depending on call stack. A depth override does
# not lift that ceiling; capacity errors report observed/configured depth
# and LIVESYNC_JOURNAL_MAX_JSON_DEPTH. Reduce nesting; raising it alone
# cannot fix decoder capacity.
# Bytes/counts/depths are integers; refresh seconds must be finite and may be
# fractional (e.g. 0.25). All values must be >0 and <2**63. Defaults below.
# See README Size behavior and replay_limits.py for derivation/headroom.
LIVESYNC_JOURNAL_MAX_LINE_BYTES=268435456
LIVESYNC_JOURNAL_MAX_INFLATED_BYTES=8589934592
LIVESYNC_JOURNAL_MAX_RECORDS=1000000
LIVESYNC_JOURNAL_MAX_JSON_DEPTH=512
LIVESYNC_JOURNAL_MAX_OBJECT_BYTES=8589934592
LIVESYNC_JOURNAL_MAX_REFRESH_KEYS=1000000
LIVESYNC_JOURNAL_MAX_REFRESH_BYTES=68719476736
LIVESYNC_JOURNAL_MAX_REFRESH_SECONDS=3600

# CouchDB enableCompression follows the vault; no environment override.
# Compressed reads are unconditional, including with the mismatch bypass flag.
# Local tweak compatibility policy (not advertised in milestone tweak_values).
# true bypasses ordinary differences, never ID/path identity or E2EE refusals.
LIVESYNC_DISABLE_CHECKING_CONFIG_MISMATCH=false
# Auto-align fully advertised, compatible-lossy chunk tweaks by tweakModified.
LIVESYNC_AUTO_ACCEPT_COMPATIBLE_TWEAK=true

# Aggregate scan limits, positive integers; truncated scans report their limits.
LIVESYNC_SCAN_MAX_NOTES=10000
LIVESYNC_SCAN_MAX_BYTES=67108864

# Unsafe diagnostic last-line sink, separate from config.py; keep disabled.
# Requires DEBUG logging too. Never enable to collect credentials.
# LIVESYNC_UNSAFE_DEBUG=0

# Chunk settings come from the vault, not environment overrides.
# customChunkSize/minimumChunkSize follow terminating plugin behavior.
# For plugin loop refusals and recovery see docs/vault-format.md.
